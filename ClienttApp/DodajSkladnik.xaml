<Window x:Class="ClienttApp.DodajSkladnik"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClienttApp"
        mc:Ignorable="d"
        Title="DodajSkladnik" Height="200" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Lavender">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Produkt -->
            <RowDefinition Height="40"/>
            <!-- Jednostka -->
            <RowDefinition/>
            <!-- Przycisk -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="81*"/>
        </Grid.ColumnDefinitions>

        <!-- Produkt -->
        <TextBlock Grid.Column="0" Text="Produkt:" 
                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="5,0,5,0"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbNameProduct" IsEditable="False"
                  FontSize="14" Margin="5,5,5,5" Grid.ColumnSpan="2" />

        <!-- Ilość -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ilość:" 
                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="5,0,5,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCount" 
                 FontSize="14" Margin="5,5,5,5" Grid.ColumnSpan="2" />

        <!-- Przycisk -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="32,7,0,0" Grid.Column="1" Grid.ColumnSpan="2">
            <Button Content="Dodaj" Background="#FFD1B9FF" Width="100" Height="30" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Anuluj" Background="#FFD1B9FF" Width="100" Height="30" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>

</Window>
