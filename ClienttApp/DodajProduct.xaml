<Window x:Class="ClienttApp.DodajProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClienttApp"
        mc:Ignorable="d"
        Title="DodajProduct" MinHeight="300" MinWidth="500" Height="300" Width="500"
        Background="Lavender">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <!-- Nazwa -->
            <RowDefinition />
            <!-- Kalorie -->
            <RowDefinition />
            <!-- Białko -->
            <RowDefinition />
            <!-- Tłuszcze -->
            <RowDefinition />
            <!-- Węglowodany -->
            <RowDefinition />
            <!-- Jednostka (MetricType) -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Nazwa produktu -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa produktu:" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 FontSize="16" FontWeight="Bold" Background="WhiteSmoke" Margin="5"
                 x:Name="txtNameProduct" HorizontalAlignment="Stretch"/>

        <!-- Kalorie -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kalorie (kcal):" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 FontSize="16" Background="WhiteSmoke" Margin="5"
                 x:Name="txtCalories" HorizontalAlignment="Stretch"/>

        <!-- Białko -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Białko (g):" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 FontSize="16" Background="WhiteSmoke" Margin="5"
                 x:Name="txtProtein" HorizontalAlignment="Stretch"/>

        <!-- Tłuszcze -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tłuszcze (g):" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 FontSize="16" Background="WhiteSmoke" Margin="5"
                 x:Name="txtFat" HorizontalAlignment="Stretch"/>

        <!-- Węglowodany -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Węglowodany (g):" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                 FontSize="16" Background="WhiteSmoke" Margin="5"
                 x:Name="txtCab" HorizontalAlignment="Stretch"/>

        <!-- Jednostka (MetricType) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Jednostka (MetricType):" 
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="5" Grid.Column="1"
         FontSize="16" FontWeight="Bold" Background="WhiteSmoke" Margin="5"
         x:Name="txtMetricType" HorizontalAlignment="Stretch"/>

        <!-- Przycisk -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnZapisz" Content="Zapisz produkt" Width="100" Height="20" Margin="0 0 0 5" Click="Zapisz_CLick"/>
            <Button x:Name="btnAnuluj"  Content="Anuluj" Width="100" Height="20" Margin="5 0 0 5" Click="Anuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
