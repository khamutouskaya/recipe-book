<UserControl x:Class="ClienttApp.ProductComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClienttApp"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Grid Background="Lavender">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" x:Name="TextName" Text="Name" Margin="10" TextAlignment="Center" VerticalAlignment="Center" FontSize="20"></TextBlock>
        
        <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="20" Margin="0 5 30 0" Click="OnEdit">Edit</Button>
        <Button x:Name="BtnDelete" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Margin="0 5 5 0" Click="OnDelete">X</Button>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="DarkGray" BorderThickness="0 3 0 0"></Border>

        <TextBlock Grid.Row="1" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="Białka"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="Tłuszcze"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="Węgli"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="3" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="Kalorie"></TextBlock>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" BorderBrush="DarkGray" BorderThickness="0 0 3 0"></Border>
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" BorderBrush="DarkGray" BorderThickness="0 0 3 0"></Border>
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" BorderBrush="DarkGray" BorderThickness="0 0 3 0"></Border>

        <TextBlock x:Name="TextProtein" Grid.Row="2" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="0"></TextBlock>
        <TextBlock x:Name="TextFat" Grid.Row="2" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="0"></TextBlock>
        <TextBlock x:Name="TextCab" Grid.Row="2" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="0"></TextBlock>
        <TextBlock x:Name="TextCalories" Grid.Row="2" Grid.Column="3" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="0"></TextBlock>
    </Grid>
</UserControl>
